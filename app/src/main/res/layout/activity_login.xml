<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dungeon"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <!-- ===== CABEÇALHO ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🐉"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="FORJADOR DE QUESTS"
            android:textColor="@color/flame_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:text="entre para continuar sua jornada"
            android:textColor="@color/parchment_edge"
            android:textSize="13sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

        <!-- ===== CARD: LOGIN ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_scroll"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 ENTRAR"
                android:textColor="@color/ink_dark"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textColor="@color/ink_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textEmailAddress"
                android:background="@drawable/edittext_scroll"
                android:hint="seu@email.com"
                android:textColorHint="#9C8A66"
                android:textColor="@color/ink_dark"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="@color/ink_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textPassword"
                android:background="@drawable/edittext_scroll"
                android:hint="••••••••"
                android:textColorHint="#9C8A66"
                android:textColor="@color/ink_dark"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- ===== BOTÃO DE AÇÃO ===== -->
        <Button
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/button_ember"
            android:text="⚔  ENTRAR"
            android:textColor="@color/parchment"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="serif"
            android:elevation="4dp" />

        <ProgressBar
            android:id="@+id/progressBarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvErroLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvIrParaCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Não tem conta? Cadastre-se"
            android:textColor="@color/arcane_purple_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>