<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dungeon"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="🏰"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvNomeSala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Nome da Sala"
            android:textColor="@color/flame_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="serif"
            android:gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/divider_ornate" />

        <!-- ===== CARD: CÓDIGO DA SALA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_scroll"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 CÓDIGO DA SALA — compartilhe com o grupo"
                android:textColor="@color/ink_dark"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCodigoSala"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="------"
                android:textColor="@color/ember_red"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ===== CARD: PARTICIPANTES ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_scroll"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧙 AVENTUREIROS NA SALA"
                android:textColor="@color/ink_dark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvMestreNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔮 Mestre: —"
                android:textColor="@color/arcane_purple_light"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvListaParticipantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum jogador ainda."
                android:textColor="@color/ink_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>