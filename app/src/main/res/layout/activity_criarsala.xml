<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dungeon"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🔮"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="CRIAR SALA"
            android:textColor="@color/flame_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:text="reúna seu grupo para a aventura"
            android:textColor="@color/parchment_edge"
            android:textSize="13sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

        <!-- ===== CARD: NOVA SALA ===== -->
        <LinearLayout
            android:id="@+id/grupoCriar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_scroll"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 NOME DA SALA"
                android:textColor="@color/ink_dark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etNomeSala"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_scroll"
                android:hint="ex: A Névoa de Ravenhold"
                android:textColorHint="#9C8A66"
                android:textColor="@color/ink_dark"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCriarSala"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/button_arcane"
            android:text="🔮  CRIAR SALA"
            android:textColor="@color/parchment"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="serif"
            android:elevation="4dp" />

        <ProgressBar
            android:id="@+id/progressBarCriarSala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvErroCriarSala"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>